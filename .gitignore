# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# ─── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Experiment tracking ──────────────────────────────────────────────────────
wandb/
runs/
lightning_logs/

# ─── Model weights & checkpoints ──────────────────────────────────────────────
# HuggingFace cached models go in ~/.cache — not here
# Project checkpoints: too large for git, use DVC or external storage
checkpoints/
*.pt
*.pth
*.bin
*.ckpt
*.safetensors

# ─── Genomic raw data — large, re-downloadable from NCBI SRA / RefSeq ────────
mammoth_sra/mammoth/*.fastq
mammoth_sra/mammoth/*.sai
mammoth_sra/mammoth/*.bam
mammoth_sra/mammoth/*.bam.bai
mammoth_sra/mammoth/ERR855944/
mammoth_sra/mammoth/ERR852028/

# ─── Reference genome — large, re-downloadable from NCBI RefSeq ──────────────
mammoth_sra/elephant_reference/*.fa
mammoth_sra/elephant_reference/*.fa.amb
mammoth_sra/elephant_reference/*.fa.ann
mammoth_sra/elephant_reference/*.fa.bwt
mammoth_sra/elephant_reference/*.fa.fai
mammoth_sra/elephant_reference/*.fa.pac
mammoth_sra/elephant_reference/*.fa.sa
mammoth_sra/elephant_reference/ncbi_dataset/
mammoth_sra/elephant_reference/ncbi_dataset.zip

# ─── What IS tracked ─────────────────────────────────────────────────────────
# mammoth_sra/mammoth/runs.txt          — SRA accession list
# mammoth_sra/mammoth/md5sum.txt        — checksums for integrity verification
# mammoth_sra/results/                  — mapDamage2 output (small, irreproducible without full run)
# Documentation/                        — all paper documentation
# All source code (*.py, *.sh, *.yaml)

# ─── Secrets ──────────────────────────────────────────────────────────────────
.env
*.key
