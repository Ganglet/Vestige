# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# ─── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Experiment tracking ──────────────────────────────────────────────────────
wandb/
runs/
lightning_logs/

# ─── Model weights & checkpoints ──────────────────────────────────────────────
# HuggingFace cached models go in ~/.cache — not here
# Project checkpoints: too large for git, use DVC or external storage
checkpoints/
*.pt
*.pth
*.bin
*.ckpt
*.safetensors

# ─── Genomic raw data — large, re-downloadable from NCBI SRA / RefSeq ────────
Dataset/mammoth/*.fastq
Dataset/mammoth/*.sai
Dataset/mammoth/*.bam
Dataset/mammoth/*.bam.bai
Dataset/mammoth/ERR855944/
Dataset/mammoth/ERR852028/

# ─── Reference genome — large, re-downloadable from NCBI RefSeq ──────────────
Dataset/elephant_reference/*.fa
Dataset/elephant_reference/*.fa.amb
Dataset/elephant_reference/*.fa.ann
Dataset/elephant_reference/*.fa.bwt
Dataset/elephant_reference/*.fa.fai
Dataset/elephant_reference/*.fa.pac
Dataset/elephant_reference/*.fa.sa
Dataset/elephant_reference/ncbi_dataset/
Dataset/elephant_reference/ncbi_dataset.zip

# ─── What IS tracked ─────────────────────────────────────────────────────────
# Dataset/mammoth/runs.txt          — SRA accession list
# Dataset/mammoth/md5sum.txt        — checksums for integrity verification
# Dataset/results/                  — mapDamage2 output (small, irreproducible without full run)
# Documentation/                        — all paper documentation
# All source code (*.py, *.sh, *.yaml)

# ─── Secrets ──────────────────────────────────────────────────────────────────
.env
*.key
Paper/